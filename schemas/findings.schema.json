{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings.json (argument of the submit action)",
  "type": "object",
  "required": ["episode_id", "findings"],
  "properties": {
    "episode_id": {"type": "string"},
    "findings": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids", "explanation"],
        "properties": {
          "type": {"enum": ["duplicate_invoice", "payment_allocation", "fx_error", "period_cutoff"]},
          "affected_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 10},
          "claimed_amount_minor": {"type": "integer", "minimum": 0},
          "currency": {"type": "string", "minLength": 3, "maxLength": 3},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
          "explanation": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
